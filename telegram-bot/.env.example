# Copy to telegram-bot/.env. Never commit the completed file.
TELEGRAM_BOT_TOKEN=
# Generate in the application's Integración settings. Revocation takes effect immediately.
FINANZAS_API_KEY=
FINANZAS_API_URL=http://127.0.0.1:3001
# Comma-separated numeric Telegram user IDs. An empty list prevents startup.
TELEGRAM_ALLOWED_USER_IDS=
# Optional existing account name or ID. The API selects its default account if omitted.
FINANZAS_DEFAULT_ACCOUNT=
# Optional existing category name or ID. Usually leave blank for autocategorization.
FINANZAS_DEFAULT_CATEGORY=
