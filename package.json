{
  "name": "finanzas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "telegram-bot"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run db:generate -w server && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w server",
    "db:push": "npm run db:push -w server",
    "db:migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
